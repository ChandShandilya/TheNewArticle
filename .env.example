# --- Database ---
DATABASE_URL="postgresql://tna:tna@localhost:5432/thenewarticle?schema=public"

# --- Cache / queues ---
REDIS_URL="redis://localhost:6379"

# --- API ---
API_PORT=4000
# Comma-separated origins allowed to call the API
CORS_ORIGINS="http://localhost:3000"

# --- Web ---
# Base URL the Next.js server uses to reach the API (server-side fetch)
API_BASE_URL="http://localhost:4000"
NEXT_PUBLIC_SITE_NAME="TheNewArticle"

# --- Ingestion ---
# Active source adapter: "mock-india" for Phase 1. Real adapters add keys below.
INGEST_SOURCE="mock-india"
# NEWSAPI_KEY=""
# NEWSDATA_API_KEY=""
# WORLDNEWS_API_KEY=""
